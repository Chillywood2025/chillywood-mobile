{
  "schemaVersion": 1,
  "contractId": "gate-catalog-v1",
  "schemaRef": "config/assurance/schemas-v1.json#/$defs/gateCatalog",
  "statuses": ["REQUIREMENTS_CLEAR", "ARCHITECTURE_CLEAR", "SOURCE_CLEAR", "MODEL_CLEAR", "INTEGRATION_CLEAR", "NATIVE_CLEAR", "PROVIDER_CLEAR", "ARTIFACT_CLEAR", "INSTALLED_CLEAR", "PHYSICAL_CLEAR", "RELEASE_CLEAR", "BLOCKED_INTERNAL", "BLOCKED_EXTERNAL", "NOT_APPLICABLE", "SUPERSEDED"],
  "gates": [
    {"id": "T0_REQUIREMENT", "passStatus": "REQUIREMENTS_CLEAR", "requiredBefore": ["implementation"], "missingStatus": "BLOCKED_INTERNAL"},
    {"id": "T1_SOURCE", "passStatus": "SOURCE_CLEAR", "requiredBefore": ["pre-artifact"], "missingStatus": "BLOCKED_INTERNAL"},
    {"id": "T2_MODEL", "passStatus": "MODEL_CLEAR", "requiredBefore": ["pre-artifact"], "missingStatus": "BLOCKED_INTERNAL"},
    {"id": "T3_INTEGRATION", "passStatus": "INTEGRATION_CLEAR", "requiredBefore": ["pre-artifact"], "missingStatus": "BLOCKED_INTERNAL"},
    {"id": "T4_NATIVE_PROVIDER", "passStatus": ["NATIVE_CLEAR", "PROVIDER_CLEAR"], "requiredBefore": ["pre-artifact"], "missingStatus": "BLOCKED_INTERNAL"},
    {"id": "T5_SIGNED_ARTIFACT", "passStatus": "ARTIFACT_CLEAR", "requiredBefore": ["installed"], "missingStatus": "BLOCKED_EXTERNAL"},
    {"id": "T6_INSTALLED_PHYSICAL", "passStatus": ["INSTALLED_CLEAR", "PHYSICAL_CLEAR"], "requiredBefore": ["release"], "missingStatus": "BLOCKED_EXTERNAL"},
    {"id": "T7_PUBLIC_CANARY", "passStatus": "RELEASE_CLEAR", "requiredBefore": ["public-release"], "missingStatus": "BLOCKED_EXTERNAL"}
  ],
  "phaseBlockers": {
    "implementation": ["T0_REQUIREMENT"],
    "buildOrOta": ["T0_REQUIREMENT", "T1_SOURCE", "T2_MODEL", "T3_INTEGRATION", "T4_NATIVE_PROVIDER"],
    "merge": ["applicable-gates", "exact-head-review", "current-truth", "scope", "migration-parity"],
    "publicRelease": ["T0_REQUIREMENT", "T1_SOURCE", "T2_MODEL", "T3_INTEGRATION", "T4_NATIVE_PROVIDER", "T5_SIGNED_ARTIFACT", "T6_INSTALLED_PHYSICAL", "T7_PUBLIC_CANARY", "LEVEL_D_OWNER_APPROVAL"]
  },
  "completionLanguage": {"unqualified": ["COMPLETE", "CLOSED", "DONE", "READY", "P0_CLEAR", "P1_CLEAR"], "rule": "Every applicable tier is reported separately; pending higher tiers cannot be summarized as complete."}
}
