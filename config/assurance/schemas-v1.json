{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chillywood.local/assurance/schemas-v1.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.:-]*$"},
    "lowerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gitBranch": {"type": "string", "pattern": "^(?!-)(?!/)(?!@$)(?!HEAD$)(?!.*(?:^|/)\\.)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*(?:\\.\\.|//|@\\{|[\\u0000-\\u0020~^:?*\\[\\]\\\\\\u007f]))(?!.*[/.]$).+$"},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["REQUIREMENTS_CLEAR", "ARCHITECTURE_CLEAR", "SOURCE_CLEAR", "MODEL_CLEAR", "INTEGRATION_CLEAR", "NATIVE_CLEAR", "PROVIDER_CLEAR", "ARTIFACT_CLEAR", "INSTALLED_CLEAR", "PHYSICAL_CLEAR", "RELEASE_CLEAR", "BLOCKED_INTERNAL", "BLOCKED_EXTERNAL", "NOT_APPLICABLE", "SUPERSEDED"]},
    "baseContract": {
      "type": "object",
      "required": ["schemaVersion", "contractId"],
      "properties": {"schemaVersion": {"const": 1}, "contractId": {"type": "string"}},
      "additionalProperties": true
    },
    "gateCatalog": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["statuses", "gates", "phaseBlockers"],
      "properties": {"statuses": {"type": "array", "items": {"$ref": "#/$defs/status"}, "uniqueItems": true}, "gates": {"type": "array", "minItems": 8}, "phaseBlockers": {"type": "object"}}
    },
    "proofStrength": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["tiers", "claimRule"],
      "properties": {"tiers": {"type": "array", "minItems": 8}, "claimRule": {"type": "string"}}
    },
    "proofSubstitutionDenylist": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["mode", "substitutions"],
      "properties": {"mode": {"const": "reject"}, "substitutions": {"type": "array", "minItems": 35}}
    },
    "prScopePolicy": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["defaultBudget", "timeboxesHours", "domains", "violations", "waiverRequirements"],
      "properties": {"domains": {"type": "array", "minItems": 13}}
    },
    "reviewContract": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["manifestRequiredFields", "reviewOnlyRules", "invalidations", "levels"]
    },
    "testImpactMap": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["pathRules", "riskCommands", "supportingDomain"]
    },
    "currentTruthContract": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["recordPath", "generatedDocuments", "requiredFields", "synchronizationMerge", "implementationHeadBinding", "freshness", "staleFindingIds"],
      "properties": {
        "synchronizationMerge": {
          "type": "object",
          "required": ["required", "parentCount", "recordedMainMustBeFirstParent", "requiredChangedPaths", "allowedChangedPaths", "bootstrapMerge"],
          "properties": {
            "required": {"const": true},
            "parentCount": {"const": 2},
            "recordedMainMustBeFirstParent": {"const": true},
            "requiredChangedPaths": {"type": "array", "minItems": 3, "uniqueItems": true},
            "allowedChangedPaths": {"type": "array", "minItems": 3, "uniqueItems": true},
            "bootstrapMerge": {
              "type": "object",
              "required": ["mergeSha", "firstParent", "changedPaths"],
              "properties": {
                "mergeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "firstParent": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "changedPaths": {"type": "array", "minItems": 3, "uniqueItems": true}
              }
            }
          }
        },
        "implementationHeadBinding": {
          "type": "object",
          "required": ["required", "networkAccess", "refNamespace", "missingRef", "malformedSha", "duplicatePrOrBranch", "recordedObservedMismatch", "listedCurrentBranchCheckoutMustMatch", "namedMainCheckoutMustEqualOriginMain", "providerSnapshotImplementationFields", "providerSnapshotInventoryMismatch", "providerSnapshotReadOrRootFailure", "providerSnapshotState", "detachedCi", "unlistedBranchPolicy"],
          "properties": {
            "required": {"const": true},
            "networkAccess": {"const": "forbidden"},
            "refNamespace": {"const": "refs/remotes/origin/"},
            "missingRef": {"const": "BLOCKED_INTERNAL"},
            "malformedSha": {"const": "BLOCKED_INTERNAL"},
            "duplicatePrOrBranch": {"const": "BLOCKED_INTERNAL"},
            "recordedObservedMismatch": {"const": "BLOCKED_INTERNAL"},
            "listedCurrentBranchCheckoutMustMatch": {"const": true},
            "namedMainCheckoutMustEqualOriginMain": {"const": true},
            "providerSnapshotImplementationFields": {"type": "array", "items": {"enum": ["number", "branch", "head", "state"]}, "minItems": 4, "maxItems": 4, "uniqueItems": true},
            "providerSnapshotInventoryMismatch": {"const": "BLOCKED_INTERNAL"},
            "providerSnapshotReadOrRootFailure": {"const": "BLOCKED_INTERNAL"},
            "providerSnapshotState": {"const": "nonblank-trimmed-string"},
            "detachedCi": {"const": "explicit-branch-and-head-required-unless-head-is-origin-main"},
            "unlistedBranchPolicy": {"const": "deferred-to-pr-e"}
          }
        },
        "freshness": {
          "type": "object",
          "required": ["defaultHours", "providerCriticalHours", "clock", "failClosed", "classes", "factRegistry"],
          "properties": {
            "defaultHours": {"const": 24},
            "providerCriticalHours": {"const": 8},
            "clock": {"const": "UTC"},
            "failClosed": {"const": true},
            "factRegistry": {"const": [
              {"factId": "repository.active-implementation.immutable-synchronized-source", "freshnessClass": "REPOSITORY_SOURCE", "authorityAllowed": "REPOSITORY_ONLY", "platform": "NONE", "provider": "NONE"},
              {"factId": "repository.active-implementation.merge-identity", "freshnessClass": "REPOSITORY_SOURCE", "authorityAllowed": "REPOSITORY_ONLY", "platform": "NONE", "provider": "NONE"},
              {"factId": "repository.review-only-pr.disposition", "freshnessClass": "REPOSITORY_SOURCE", "authorityAllowed": "REPOSITORY_ONLY", "platform": "NONE", "provider": "NONE"},
              {"factId": "repository.phase1-ci.identity", "freshnessClass": "REPOSITORY_SOURCE", "authorityAllowed": "REPOSITORY_ONLY", "platform": "NONE", "provider": "NONE"},
              {"factId": "repository.d2a.frozen-state", "freshnessClass": "REPOSITORY_SOURCE", "authorityAllowed": "REPOSITORY_ONLY", "platform": "NONE", "provider": "NONE"},
              {"factId": "provider.supabase.b3.deployed-predecessor", "freshnessClass": "PROVIDER_CRITICAL", "authorityAllowed": "PROVIDER_READBACK_ONLY", "platform": "NONE", "provider": "SUPABASE", "historicalEvidence": "exact deployed 20260730161737 source SHA-256 6cb22f9719c5c1325ac4ee814998a39e50318d92499504e8f4ece52717d5a765"},
              {"factId": "provider.supabase.b3.forward-correction", "freshnessClass": "PROVIDER_CRITICAL", "authorityAllowed": "PROVIDER_READBACK_ONLY", "platform": "NONE", "provider": "SUPABASE", "historicalEvidence": "undeployed forward correction 20260730230031 SHA-256 0d610a322fa54ae411609736d2db30031944e1d77ac9fc8ac722bd4cd6d70d38"},
              {"factId": "provider.supabase.b3.live-acl", "freshnessClass": "PROVIDER_CRITICAL", "authorityAllowed": "PROVIDER_READBACK_ONLY", "platform": "NONE", "provider": "SUPABASE", "historicalEvidence": "live pre-correction ACL explicitly includes anon but source correction revokes it"}
            ]},
            "classes": {
              "type": "object",
              "required": ["REPOSITORY_SOURCE", "PROVIDER_CRITICAL", "SIGNED_ARTIFACT", "INSTALLED_DEVICE", "PHYSICAL_DEVICE", "PUBLIC_CANARY"],
              "additionalProperties": false,
              "properties": {
                "REPOSITORY_SOURCE": {
                  "type": "object",
                  "required": ["maximumHours", "allowedEvidenceModes", "authorityAllowed"],
                  "properties": {
                    "maximumHours": {"const": 24},
                    "allowedEvidenceModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["local-source", "git-read-only", "github-read-only", "exact-ci", "local-offline", "local-read-only", "local-and-github-read-only", "local-offline-and-github-read-only"]}},
                    "authorityAllowed": {"const": "REPOSITORY_ONLY"}
                  }
                },
                "PROVIDER_CRITICAL": {
                  "type": "object",
                  "required": ["maximumHours", "allowedEvidenceModes", "authorityAllowed", "requiresCommittedEvidence"],
                  "properties": {
                    "maximumHours": {"const": 8},
                    "allowedEvidenceModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "local-and-linked-read-only"}},
                    "authorityAllowed": {"const": "PROVIDER_READBACK_ONLY"},
                    "requiresCommittedEvidence": {"const": true}
                  }
                },
                "SIGNED_ARTIFACT": {"$ref": "#/$defs/signedArtifactFreshnessRule"},
                "INSTALLED_DEVICE": {"$ref": "#/$defs/installedDeviceFreshnessRule"},
                "PHYSICAL_DEVICE": {"$ref": "#/$defs/physicalDeviceFreshnessRule"},
                "PUBLIC_CANARY": {"$ref": "#/$defs/publicCanaryFreshnessRule"}
              }
            }
          }
        }
      }
    },
    "signedArtifactFreshnessRule": {
      "type": "object",
      "required": ["maximumHours", "allowedEvidenceModes", "authorityAllowed", "requiresCommittedEvidence"],
      "properties": {"maximumHours": {"const": 24}, "allowedEvidenceModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "signed-artifact-inspection"}}, "authorityAllowed": {"const": "SIGNED_ARTIFACT_ONLY"}, "requiresCommittedEvidence": {"const": true}}
    },
    "installedDeviceFreshnessRule": {
      "type": "object",
      "required": ["maximumHours", "allowedEvidenceModes", "authorityAllowed", "requiresCommittedEvidence"],
      "properties": {"maximumHours": {"const": 24}, "allowedEvidenceModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "installed-device-readback"}}, "authorityAllowed": {"const": "INSTALLED_DEVICE_ONLY"}, "requiresCommittedEvidence": {"const": true}}
    },
    "physicalDeviceFreshnessRule": {
      "type": "object",
      "required": ["maximumHours", "allowedEvidenceModes", "authorityAllowed", "requiresCommittedEvidence"],
      "properties": {"maximumHours": {"const": 24}, "allowedEvidenceModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "physical-device-observation"}}, "authorityAllowed": {"const": "PHYSICAL_DEVICE_ONLY"}, "requiresCommittedEvidence": {"const": true}}
    },
    "publicCanaryFreshnessRule": {
      "type": "object",
      "required": ["maximumHours", "allowedEvidenceModes", "authorityAllowed", "requiresCommittedEvidence"],
      "properties": {"maximumHours": {"const": 24}, "allowedEvidenceModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "public-canary-readback"}}, "authorityAllowed": {"const": "PUBLIC_CANARY_ONLY"}, "requiresCommittedEvidence": {"const": true}}
    },
    "requiredFreshnessClaim": {
      "type": "object",
      "required": ["freshnessClass", "platform", "evidenceSourceId", "authorityAllowed", "requiredFacts"],
      "properties": {
        "freshnessClass": {"enum": ["REPOSITORY_SOURCE", "PROVIDER_CRITICAL", "SIGNED_ARTIFACT", "INSTALLED_DEVICE", "PHYSICAL_DEVICE", "PUBLIC_CANARY"]},
        "platform": {"enum": ["ANDROID", "IOS", "NONE"]},
        "evidenceSourceId": {"$ref": "#/$defs/lowerId"},
        "authorityAllowed": {"enum": ["REPOSITORY_ONLY", "PROVIDER_READBACK_ONLY", "SIGNED_ARTIFACT_ONLY", "INSTALLED_DEVICE_ONLY", "PHYSICAL_DEVICE_ONLY", "PUBLIC_CANARY_ONLY"]},
        "requiredFacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "currentTruthRecord": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["mainSha", "latestMergedImplementationPr", "android", "ios", "remoteMigrationHead", "enabledCognitiveSwitches", "enabledSchedules", "effectiveBaselineCount", "operationalClosures", "operatingPolicy", "blockedProviders", "openImplementationPrs", "openReviewOnlyPrs", "activeTaskBinding", "freshnessClaims", "lateReviewSentinels", "assuranceProgram", "timestamp", "freshnessDeadline", "evidenceSources", "liveProviderReadback"],
      "properties": {
        "mainSha": {"$ref": "#/$defs/gitSha"},
        "remoteMigrationHead": {"type": "string", "pattern": "^[0-9]{14}$"},
        "liveProviderReadback": {"type": "boolean"},
        "activeTaskBinding": {
          "type": "object",
          "required": ["schemaVersion", "featureId", "implementationPr", "implementationBranch", "implementationBindingId", "immutableSourceHead", "immutableSourceTree", "currentImplementationHead", "currentImplementationTree", "phase", "executionState", "requiredFreshnessClasses", "requiredFreshnessClaims", "proofTiersUnderEvaluation"],
          "properties": {
            "schemaVersion": {"const": 1},
            "featureId": {"$ref": "#/$defs/lowerId"},
            "implementationPr": {"type": "integer", "minimum": 1},
            "implementationBranch": {"$ref": "#/$defs/gitBranch"},
            "implementationBindingId": {"$ref": "#/$defs/lowerId"},
            "immutableSourceHead": {"$ref": "#/$defs/gitSha"},
            "immutableSourceTree": {"$ref": "#/$defs/gitSha"},
            "currentImplementationHead": {"$ref": "#/$defs/gitSha"},
            "currentImplementationTree": {"$ref": "#/$defs/gitSha"},
            "phase": {"enum": ["IMPLEMENTATION", "FORMAL_REVIEW", "FINAL_CI", "MERGE_ELIGIBLE", "COMPLETE"]},
            "executionState": {"type": "string", "minLength": 1},
            "requiredFreshnessClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["REPOSITORY_SOURCE", "PROVIDER_CRITICAL", "SIGNED_ARTIFACT", "INSTALLED_DEVICE", "PHYSICAL_DEVICE", "PUBLIC_CANARY"]}},
            "requiredFreshnessClaims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/requiredFreshnessClaim"}},
            "proofTiersUnderEvaluation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["T0_REQUIREMENT", "T1_SOURCE", "T2_MODEL", "T3_INTEGRATION", "T4_NATIVE_PROVIDER", "T5_SIGNED_ARTIFACT", "T6_INSTALLED_PHYSICAL", "T7_PUBLIC_CANARY"]}}
          }
        },
        "freshnessClaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "observedAt", "expiresAt", "evidenceSourceId", "evidenceMode", "factsCovered", "freshnessClass", "authorityAllowed", "platform", "provider"],
            "properties": {
              "id": {"$ref": "#/$defs/lowerId"},
              "status": {"enum": ["CURRENT", "STALE_BLOCKED"]},
              "observedAt": {"type": "string", "format": "date-time"},
              "expiresAt": {"type": "string", "format": "date-time"},
              "evidenceSourceId": {"$ref": "#/$defs/lowerId"},
              "evidenceMode": {"type": "string", "minLength": 1},
              "factsCovered": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "freshnessClass": {"enum": ["REPOSITORY_SOURCE", "PROVIDER_CRITICAL", "SIGNED_ARTIFACT", "INSTALLED_DEVICE", "PHYSICAL_DEVICE", "PUBLIC_CANARY"]},
              "authorityAllowed": {"enum": ["REPOSITORY_ONLY", "PROVIDER_READBACK_ONLY", "SIGNED_ARTIFACT_ONLY", "INSTALLED_DEVICE_ONLY", "PHYSICAL_DEVICE_ONLY", "PUBLIC_CANARY_ONLY"]},
              "platform": {"enum": ["ANDROID", "IOS", "NONE"]},
              "provider": {"type": "string", "minLength": 1}
            }
          }
        },
        "openImplementationPrs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["number", "branch", "head", "state", "disposition"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "branch": {"$ref": "#/$defs/gitBranch"},
              "head": {"$ref": "#/$defs/gitSha"},
              "state": {"enum": ["open", "open-draft-current"]},
              "disposition": {"type": "string"}
            }
          }
        },
        "lateReviewSentinels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["classification", "repository", "prNumber", "mergedAt", "mergeSha", "reviewedSha", "reviewId", "reviewCompletedAt", "findings", "bindingPath", "successorCorrectionOwner", "authorizedBootstrapOwners", "blocks"],
            "properties": {
              "classification": {"const": "MERGED_WITH_UNRESOLVED_EXACT_HEAD_REVIEW"},
              "repository": {"type": "string", "minLength": 1},
              "prNumber": {"type": "integer", "minimum": 1},
              "mergedAt": {"type": "string", "format": "date-time"},
              "mergeSha": {"$ref": "#/$defs/gitSha"},
              "reviewedSha": {"$ref": "#/$defs/gitSha"},
              "reviewId": {"type": "integer", "minimum": 1},
              "reviewCompletedAt": {"type": "string", "format": "date-time"},
              "findings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["sourceType", "sourceId", "provider", "bodyHash", "severity", "timestamp", "reviewedSha", "reviewedHeadClassification", "threadResolutionState", "affectedPaths", "disposition"],
                  "properties": {
                    "sourceType": {"enum": ["REVIEW_BODY", "INLINE_THREAD", "ISSUE_COMMENT"]},
                    "sourceId": {"type": "number"},
                    "provider": {"type": "string", "minLength": 1},
                    "bodyHash": {"pattern": "^[0-9a-f]{64}$"},
                    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
                    "timestamp": {"type": "string", "format": "date-time"},
                    "reviewedSha": {"$ref": "#/$defs/gitSha"},
                    "reviewedHeadClassification": {"enum": ["CURRENT_HEAD", "STALE_HEAD", "UNBOUND"]},
                    "threadResolutionState": {"enum": ["UNRESOLVED", "RESOLVED", "NOT_APPLICABLE"]},
                    "affectedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                    "disposition": {"enum": ["UNRESOLVED", "RESOLVED"]}
                  }
                }
              },
              "bindingPath": {"type": "string", "minLength": 1},
              "successorCorrectionOwner": {"type": "string", "minLength": 1},
              "assuranceControlOwner": {"type": "string", "minLength": 1},
              "authorizedBootstrapOwners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/gitBranch"}},
              "resolutionEvidence": {
                "type": "object",
                "required": ["schemaVersion", "successorPr", "successorBranch", "successorHead", "successorTree", "successorMergeSha", "correctedSourceIds", "resolvedThreadIds", "allThreadsResolved", "githubThreadResolutionReadbackAt", "exactHeadReviewedCommit", "exactHeadReviewedTree", "exactHeadReviewReceiptHash", "correctionEvidenceHash", "dispositionEvidenceHash", "completedAt"],
                "properties": {
                  "schemaVersion": {"const": 1},
                  "successorPr": {"type": "integer", "minimum": 1},
                  "successorBranch": {"$ref": "#/$defs/gitBranch"},
                  "successorHead": {"$ref": "#/$defs/gitSha"},
                  "successorTree": {"$ref": "#/$defs/gitSha"},
                  "successorMergeSha": {"$ref": "#/$defs/gitSha"},
                  "correctedSourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "number"}},
                  "resolvedThreadIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                  "allThreadsResolved": {"const": true},
                  "githubThreadResolutionReadbackAt": {"type": "string", "format": "date-time"},
                  "exactHeadReviewedCommit": {"$ref": "#/$defs/gitSha"},
                  "exactHeadReviewedTree": {"$ref": "#/$defs/gitSha"},
                  "exactHeadReviewReceiptHash": {"pattern": "^[0-9a-f]{64}$"},
                  "correctionEvidenceHash": {"pattern": "^[0-9a-f]{64}$"},
                  "dispositionEvidenceHash": {"pattern": "^[0-9a-f]{64}$"},
                  "completedAt": {"type": "string", "format": "date-time"}
                }
              },
              "blocks": {"type": "array", "minItems": 4, "uniqueItems": true}
            }
          }
        },
        "evidenceSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "mode", "covers"],
            "properties": {
              "id": {"$ref": "#/$defs/lowerId"},
              "mode": {"type": "string", "minLength": 1},
              "observedAt": {"type": "string", "format": "date-time"},
              "sourceCommit": {"$ref": "#/$defs/gitSha"},
              "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "freshnessClass": {"enum": ["REPOSITORY_SOURCE", "PROVIDER_CRITICAL", "SIGNED_ARTIFACT", "INSTALLED_DEVICE", "PHYSICAL_DEVICE", "PUBLIC_CANARY"]},
              "authorityAllowed": {"enum": ["REPOSITORY_ONLY", "PROVIDER_READBACK_ONLY", "SIGNED_ARTIFACT_ONLY", "INSTALLED_DEVICE_ONLY", "PHYSICAL_DEVICE_ONLY", "PUBLIC_CANARY_ONLY"]},
              "platform": {"enum": ["ANDROID", "IOS", "NONE"]}
            },
            "allOf": [{
              "if": {"required": ["observedAt"]},
              "then": {"required": ["freshnessClass", "authorityAllowed", "platform"]}
            }]
          }
        },
        "operationalClosures": {
          "type": "object",
          "required": ["installedProductQa", "revenueCat"],
          "properties": {
            "installedProductQa": {
              "type": "object",
              "required": ["schedulerStatus", "dailyTimerEnabled", "currentMatrixState", "proofRowIds", "evidenceSource"],
              "properties": {"dailyTimerEnabled": {"type": "boolean"}, "proofRowIds": {"type": "array", "minItems": 3}}
            },
            "revenueCat": {
              "type": "object",
              "required": ["providerReadbackClosed", "dashboardTest", "premiumGranted", "liveMoneyAction", "moneyMoved", "evidenceSource"],
              "properties": {
                "providerReadbackClosed": {"type": "boolean"},
                "premiumGranted": {"type": "boolean"},
                "liveMoneyAction": {"type": "boolean"},
                "moneyMoved": {"type": "boolean"}
              }
            }
          }
        },
        "operatingPolicy": {
          "type": "object",
          "required": ["modelDocument", "modelStatus", "level01OwnerApprovalRequired", "level34OwnerApprovalRequired", "evidenceSource"],
          "properties": {
            "modelDocument": {"type": "string"},
            "modelStatus": {"const": "documented-and-guarded"},
            "level01OwnerApprovalRequired": {"const": false},
            "level34OwnerApprovalRequired": {"const": true},
            "evidenceSource": {"type": "string"}
          }
        },
        "assuranceProgram": {
          "type": "object",
          "required": ["completed", "active", "nextActions", "prohibitions"],
          "properties": {
            "completed": {"type": "array"},
            "active": {"type": "string"},
            "nextActions": {"type": "array", "minItems": 1},
            "prohibitions": {"type": "array", "minItems": 1}
          }
        }
      }
    },
    "codexReviewExactHeadContract": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["checkName", "reviewProviders", "acceptableReviewStates", "blockingSeverities", "reviewOnlyLabel", "requiredEvents", "receiptRequiredFields", "receiptHash", "boundedReadback", "passRequirements", "resultCodes", "sourcePushLease", "lateReviewClassification", "lateReviewBlocks"],
      "properties": {
        "contractId": {"const": "codex-review-exact-head-v1"},
        "checkName": {"const": "Chi'llywood / Codex Review Exact Head"},
        "reviewProviders": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "chatgpt-codex-connector"}},
        "acceptableReviewStates": {"const": ["COMMENTED", "APPROVED"]},
        "blockingSeverities": {"const": ["P0", "P1", "P2"]},
        "reviewOnlyLabel": {"const": "assurance-review-only"},
        "requiredEvents": {"const": ["pull_request_target.opened", "pull_request_target.synchronize", "pull_request_target.reopened", "pull_request_target.ready_for_review", "pull_request_review.submitted", "pull_request_review.edited", "pull_request_review.dismissed", "pull_request_review_comment.created", "pull_request_review_comment.edited", "pull_request_review_comment.deleted", "pull_request_review_thread.resolved", "pull_request_review_thread.unresolved", "issue_comment.created", "issue_comment.edited", "issue_comment.deleted", "workflow_dispatch"]},
        "receiptRequiredFields": {"type": "array", "minItems": 16, "uniqueItems": true, "allOf": [
          {"contains": {"const": "repository"}}, {"contains": {"const": "prNumber"}}, {"contains": {"const": "prHeadSha"}}, {"contains": {"const": "prHeadTree"}},
          {"contains": {"const": "reviewProvider"}}, {"contains": {"const": "reviewId"}}, {"contains": {"const": "reviewState"}}, {"contains": {"const": "reviewedCommit"}},
          {"contains": {"const": "reviewStartedAt"}}, {"contains": {"const": "reviewCompletedAt"}}, {"contains": {"const": "latestSourcePushAt"}}, {"contains": {"const": "sourcePushLeaseHashes"}},
          {"contains": {"const": "reviewSubmissions"}}, {"contains": {"const": "reviewComments"}}, {"contains": {"const": "reviewThreads"}},
          {"contains": {"const": "providerIssueComments"}}, {"contains": {"const": "reviewFindings"}}, {"contains": {"const": "receiptHash"}}
        ]},
        "receiptHash": {"const": {"algorithm": "sha256", "canonicalization": "stable-json-without-receiptHash"}},
        "boundedReadback": {"const": {"reviews": 100, "threads": 100, "commentsPerThread": 100, "issueComments": 100, "maxPages": 20, "checkRuns": 100, "polling": false}},
        "passRequirements": {"const": ["reviewed-commit-equals-current-pr-head", "current-pr-tree-equals-recorded-tree", "review-completed-after-latest-source-push", "no-source-commit-after-review", "every-synchronize-event-recorded-by-exact-source-push-lease", "all-review-conversations-resolved", "all-provider-review-surfaces-read-and-head-bound", "resolved-thread-findings-require-later-exact-head-provider-rereview", "no-unresolved-blocking-finding", "exact-receipt-hash-valid"]},
        "resultCodes": {"const": ["CODEX_REVIEW_MISSING", "CODEX_REVIEW_STALE_HEAD", "CODEX_REVIEW_INCOMPLETE", "CODEX_REVIEW_BLOCKING_THREAD_OPEN", "CODEX_REVIEW_UNRESOLVED_FINDING", "CODEX_REVIEW_PROVIDER_COMMENT_HEAD_UNBOUND", "CODEX_REVIEW_READBACK_PAGINATION_INCOMPLETE", "CODEX_REVIEW_SOURCE_PUSH_LEASE_INVALID", "CODEX_REVIEW_RECEIPT_INVALID", "CODEX_REVIEW_LATE_POST_MERGE", "CODEX_REVIEW_LATE_SENTINEL_BLOCKED"]},
        "sourcePushLease": {"const": {"checkName": "Chi'llywood / Codex Review Source Push Lease", "trustedAppSlug": "github-actions", "event": "pull_request_target.synchronize", "receiptBinding": "repository-pr-head-pushedAt-sha256", "eventRunCancellationAllowed": false, "reuseAfterRepeatedHeadPush": false}},
        "lateReviewClassification": {"const": "MERGED_WITH_UNRESOLVED_EXACT_HEAD_REVIEW"},
        "lateReviewBlocks": {"const": ["post-merge-completion-claim", "next-implementation", "release", "proof-tier-promotion"]}
      }
    },
    "externalEvidenceReceiptContract": {
