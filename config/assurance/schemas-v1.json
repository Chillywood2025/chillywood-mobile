{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chillywood.local/assurance/schemas-v1.json",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.:-]*$"},
    "lowerId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gitBranch": {"type": "string", "pattern": "^(?!-)(?!/)(?!@$)(?!HEAD$)(?!.*(?:^|/)\\.)(?!.*(?:^|/)[^/]*\\.lock(?:/|$))(?!.*(?:\\.\\.|//|@\\{|[\\u0000-\\u0020~^:?*\\[\\]\\\\\\u007f]))(?!.*[/.]$).+$"},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["REQUIREMENTS_CLEAR", "ARCHITECTURE_CLEAR", "SOURCE_CLEAR", "MODEL_CLEAR", "INTEGRATION_CLEAR", "NATIVE_CLEAR", "PROVIDER_CLEAR", "ARTIFACT_CLEAR", "INSTALLED_CLEAR", "PHYSICAL_CLEAR", "RELEASE_CLEAR", "BLOCKED_INTERNAL", "BLOCKED_EXTERNAL", "NOT_APPLICABLE", "SUPERSEDED"]},
    "baseContract": {
      "type": "object",
      "required": ["schemaVersion", "contractId"],
      "properties": {"schemaVersion": {"const": 1}, "contractId": {"type": "string"}},
      "additionalProperties": true
    },
    "gateCatalog": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["statuses", "gates", "phaseBlockers"],
      "properties": {"statuses": {"type": "array", "items": {"$ref": "#/$defs/status"}, "uniqueItems": true}, "gates": {"type": "array", "minItems": 8}, "phaseBlockers": {"type": "object"}}
    },
    "proofStrength": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["tiers", "claimRule"],
      "properties": {"tiers": {"type": "array", "minItems": 8}, "claimRule": {"type": "string"}}
    },
    "proofSubstitutionDenylist": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["mode", "substitutions"],
      "properties": {"mode": {"const": "reject"}, "substitutions": {"type": "array", "minItems": 35}}
    },
    "prScopePolicy": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["defaultBudget", "timeboxesHours", "domains", "violations", "waiverRequirements"],
      "properties": {"domains": {"type": "array", "minItems": 13}}
    },
    "reviewContract": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["manifestRequiredFields", "reviewOnlyRules", "invalidations", "levels"]
    },
    "testImpactMap": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["pathRules", "riskCommands", "supportingDomain"]
    },
    "currentTruthContract": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["recordPath", "generatedDocuments", "requiredFields", "synchronizationMerge", "implementationHeadBinding", "freshness", "staleFindingIds"],
      "properties": {
        "synchronizationMerge": {
          "type": "object",
          "required": ["required", "parentCount", "recordedMainMustBeFirstParent", "requiredChangedPaths", "allowedChangedPaths", "bootstrapMerge"],
          "properties": {
            "required": {"const": true},
            "parentCount": {"const": 2},
            "recordedMainMustBeFirstParent": {"const": true},
            "requiredChangedPaths": {"type": "array", "minItems": 3, "uniqueItems": true},
            "allowedChangedPaths": {"type": "array", "minItems": 3, "uniqueItems": true},
            "bootstrapMerge": {
              "type": "object",
              "required": ["mergeSha", "firstParent", "changedPaths"],
              "properties": {
                "mergeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "firstParent": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                "changedPaths": {"type": "array", "minItems": 3, "uniqueItems": true}
              }
            }
          }
        },
        "implementationHeadBinding": {
          "type": "object",
          "required": ["required", "networkAccess", "refNamespace", "missingRef", "malformedSha", "duplicatePrOrBranch", "recordedObservedMismatch", "listedCurrentBranchCheckoutMustMatch", "namedMainCheckoutMustEqualOriginMain", "providerSnapshotImplementationFields", "providerSnapshotInventoryMismatch", "providerSnapshotReadOrRootFailure", "providerSnapshotState", "detachedCi", "unlistedBranchPolicy"],
          "properties": {
            "required": {"const": true},
            "networkAccess": {"const": "forbidden"},
            "refNamespace": {"const": "refs/remotes/origin/"},
            "missingRef": {"const": "BLOCKED_INTERNAL"},
            "malformedSha": {"const": "BLOCKED_INTERNAL"},
            "duplicatePrOrBranch": {"const": "BLOCKED_INTERNAL"},
            "recordedObservedMismatch": {"const": "BLOCKED_INTERNAL"},
            "listedCurrentBranchCheckoutMustMatch": {"const": true},
            "namedMainCheckoutMustEqualOriginMain": {"const": true},
            "providerSnapshotImplementationFields": {"type": "array", "items": {"enum": ["number", "branch", "head", "state"]}, "minItems": 4, "maxItems": 4, "uniqueItems": true},
            "providerSnapshotInventoryMismatch": {"const": "BLOCKED_INTERNAL"},
            "providerSnapshotReadOrRootFailure": {"const": "BLOCKED_INTERNAL"},
            "providerSnapshotState": {"const": "nonblank-trimmed-string"},
            "detachedCi": {"const": "explicit-branch-and-head-required-unless-head-is-origin-main"},
            "unlistedBranchPolicy": {"const": "deferred-to-pr-e"}
          }
        },
        "freshness": {
          "type": "object",
          "required": ["defaultHours", "providerCriticalHours", "clock", "failClosed", "classes"],
          "properties": {
            "defaultHours": {"const": 24},
            "providerCriticalHours": {"const": 8},
            "clock": {"const": "UTC"},
            "failClosed": {"const": true},
            "classes": {
              "type": "object",
              "required": ["REPOSITORY_SOURCE", "PROVIDER_CRITICAL", "SIGNED_ARTIFACT", "INSTALLED_DEVICE", "PHYSICAL_DEVICE", "PUBLIC_CANARY"]
            }
          }
        }
      }
    },
    "currentTruthRecord": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["mainSha", "latestMergedImplementationPr", "android", "ios", "remoteMigrationHead", "enabledCognitiveSwitches", "enabledSchedules", "effectiveBaselineCount", "operationalClosures", "operatingPolicy", "blockedProviders", "openImplementationPrs", "openReviewOnlyPrs", "activeTaskBinding", "freshnessClaims", "assuranceProgram", "timestamp", "freshnessDeadline", "evidenceSources", "liveProviderReadback"],
      "properties": {
        "mainSha": {"$ref": "#/$defs/gitSha"},
        "remoteMigrationHead": {"type": "string", "pattern": "^[0-9]{14}$"},
        "liveProviderReadback": {"type": "boolean"},
        "activeTaskBinding": {
          "type": "object",
          "required": ["schemaVersion", "featureId", "implementationPr", "implementationBranch", "implementationBindingId", "immutableSourceHead", "immutableSourceTree", "currentImplementationHead", "currentImplementationTree", "phase", "executionState", "requiredFreshnessClasses", "proofTiersUnderEvaluation"],
          "properties": {
            "schemaVersion": {"const": 1},
            "featureId": {"$ref": "#/$defs/lowerId"},
            "implementationPr": {"type": "integer", "minimum": 1},
            "implementationBranch": {"$ref": "#/$defs/gitBranch"},
            "implementationBindingId": {"$ref": "#/$defs/lowerId"},
            "immutableSourceHead": {"$ref": "#/$defs/gitSha"},
            "immutableSourceTree": {"$ref": "#/$defs/gitSha"},
            "currentImplementationHead": {"$ref": "#/$defs/gitSha"},
            "currentImplementationTree": {"$ref": "#/$defs/gitSha"},
            "phase": {"enum": ["IMPLEMENTATION", "FORMAL_REVIEW", "FINAL_CI", "MERGE_ELIGIBLE", "COMPLETE"]},
            "executionState": {"type": "string", "minLength": 1},
            "requiredFreshnessClasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["REPOSITORY_SOURCE", "PROVIDER_CRITICAL", "SIGNED_ARTIFACT", "INSTALLED_DEVICE", "PHYSICAL_DEVICE", "PUBLIC_CANARY"]}},
            "proofTiersUnderEvaluation": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["T0_REQUIREMENT", "T1_SOURCE", "T2_MODEL", "T3_INTEGRATION", "T4_NATIVE_PROVIDER", "T5_SIGNED_ARTIFACT", "T6_INSTALLED_PHYSICAL", "T7_PUBLIC_CANARY"]}}
          }
        },
        "freshnessClaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "observedAt", "expiresAt", "evidenceSourceId", "evidenceMode", "factsCovered", "freshnessClass", "authorityAllowed", "platform"],
            "properties": {
              "id": {"$ref": "#/$defs/lowerId"},
              "status": {"enum": ["CURRENT", "STALE_BLOCKED"]},
              "observedAt": {"type": "string", "format": "date-time"},
              "expiresAt": {"type": "string", "format": "date-time"},
              "evidenceSourceId": {"$ref": "#/$defs/lowerId"},
              "evidenceMode": {"type": "string", "minLength": 1},
              "factsCovered": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "freshnessClass": {"enum": ["REPOSITORY_SOURCE", "PROVIDER_CRITICAL", "SIGNED_ARTIFACT", "INSTALLED_DEVICE", "PHYSICAL_DEVICE", "PUBLIC_CANARY"]},
              "authorityAllowed": {"enum": ["REPOSITORY_ONLY", "PROVIDER_READBACK_ONLY", "SIGNED_ARTIFACT_ONLY", "INSTALLED_DEVICE_ONLY", "PHYSICAL_DEVICE_ONLY", "PUBLIC_CANARY_ONLY"]},
              "platform": {"enum": ["CROSS_PLATFORM", "ANDROID", "IOS", "NONE"]}
            }
          }
        },
        "openImplementationPrs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["number", "branch", "head", "state", "disposition"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "branch": {"$ref": "#/$defs/gitBranch"},
              "head": {"$ref": "#/$defs/gitSha"},
              "state": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
              "disposition": {"type": "string"}
            }
          }
        },
        "operationalClosures": {
          "type": "object",
          "required": ["installedProductQa", "revenueCat"],
          "properties": {
            "installedProductQa": {
              "type": "object",
              "required": ["schedulerStatus", "dailyTimerEnabled", "currentMatrixState", "proofRowIds", "evidenceSource"],
              "properties": {"dailyTimerEnabled": {"type": "boolean"}, "proofRowIds": {"type": "array", "minItems": 3}}
            },
            "revenueCat": {
              "type": "object",
              "required": ["providerReadbackClosed", "dashboardTest", "premiumGranted", "liveMoneyAction", "moneyMoved", "evidenceSource"],
              "properties": {
                "providerReadbackClosed": {"type": "boolean"},
                "premiumGranted": {"type": "boolean"},
                "liveMoneyAction": {"type": "boolean"},
                "moneyMoved": {"type": "boolean"}
              }
            }
          }
        },
        "operatingPolicy": {
          "type": "object",
          "required": ["modelDocument", "modelStatus", "level01OwnerApprovalRequired", "level34OwnerApprovalRequired", "evidenceSource"],
          "properties": {
            "modelDocument": {"type": "string"},
            "modelStatus": {"const": "documented-and-guarded"},
            "level01OwnerApprovalRequired": {"const": false},
            "level34OwnerApprovalRequired": {"const": true},
            "evidenceSource": {"type": "string"}
          }
        },
        "assuranceProgram": {
          "type": "object",
          "required": ["completed", "active", "nextActions", "prohibitions"],
          "properties": {
            "completed": {"type": "array"},
            "active": {"type": "string"},
            "nextActions": {"type": "array", "minItems": 1},
            "prohibitions": {"type": "array", "minItems": 1}
          }
        }
      }
    },
    "physicalGoldenMatrix": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["cases", "evidenceRules"],
      "properties": {"cases": {"type": "array", "minItems": 13}}
    },
    "escapedDefectCatalog": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["defects"],
      "properties": {"defects": {"type": "array", "minItems": 25}}
    },
    "featureManifest": {
      "type": "object",
      "required": ["featureId", "currentState", "ownerSystems", "productOwner", "routes", "components", "edgeFunctions", "tablesRpcs", "nativeModulesPlugins", "providers", "platformScope", "environments", "riskLevel", "requirements", "nonGoals", "states", "transitions", "invariants", "knownDefectTags", "threatFailureModes", "proofTierApplicability", "commands", "artifactRequirements", "installedRequirements", "physicalGoldenCases", "rollback", "emergencyStop", "evidenceRetention", "reviewRequirements", "unresolvedBlockers"],
      "properties": {"featureId": {"$ref": "#/$defs/lowerId"}, "currentState": {"type": "string"}, "riskLevel": {"enum": ["A", "B", "C", "D"]}}
    },
    "featureRegistry": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["features", "registryState"],
      "properties": {"features": {"type": "array", "minItems": 18, "items": {"$ref": "#/$defs/featureManifest"}}, "registryState": {"const": "REGISTERED_NOT_PROVED"}}
    },
    "scopeWaiver": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["objective", "exactReason", "reviewer", "supportingDomains", "secondHighRiskDomain", "newTimeboxHours", "fileBudget", "lineBudget", "reviewStatus"],
      "properties": {"secondHighRiskDomain": {"const": false}, "newTimeboxHours": {"maximum": 8}}
    },
    "commandAllowlist": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["commands"],
      "properties": {"commands": {"type": "array", "minItems": 11}}
    },
    "evidenceIndex": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["entries"],
      "properties": {"entries": {"type": "array", "minItems": 1}}
    },
    "reviewHistory": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["canonicalSource", "fieldContract", "protectedImplementationHeads", "closureCriteria", "implementationDispositions", "safeStaleCandidates"],
      "properties": {"safeStaleCandidates": {"type": "array", "minItems": 12}}
    },
    "efficiencyBenchmark": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["normalContinuation", "normalContinuationBytes", "unrecordedMetricPolicy", "baselines"],
      "properties": {"baselines": {"type": "array", "minItems": 2}}
    },
    "dogfood": {
      "allOf": [{"$ref": "#/$defs/baseContract"}],
      "required": ["subjects", "requiredFindingIds"],
      "properties": {"subjects": {"type": "array", "minItems": 5}, "requiredFindingIds": {"type": "array", "minItems": 7}}
    }
  }
}
