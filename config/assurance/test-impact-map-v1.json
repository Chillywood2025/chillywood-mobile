{
  "schemaVersion": 1,
  "contractId": "test-impact-map-v1",
  "schemaRef": "config/assurance/schemas-v1.json#/$defs/testImpactMap",
  "supportingDomain": "CI-test-infrastructure",
  "pathRules": [
    {"match": ["*.md", "docs/", "config/assurance/"], "gates": ["assurance-contracts", "assurance-current-truth", "assurance-pr-scope", "assurance-review-head", "links", "git-diff", "assurance-final-summary"]},
    {"match": ["supabase/migrations/", "supabase/tests/"], "gates": ["focused-pgTAP", "RLS", "assurance-concurrency", "assurance-migration-source", "full-database-frozen-head", "assurance-final-summary"]},
    {"match": ["plugins/", "modules/", "app.config.ts"], "gates": ["generated-native", "native-compile", "native-tests", "assurance-native", "assurance-ota-parity", "assurance-artifact"]},
    {"match": ["supabase/functions/revenuecat-", "supabase/functions/stripe", "tools/ios-storekit-harness/"], "gates": ["assurance-provider", "assurance-concurrency", "assurance-mutation", "money-authority-review"]},
    {"match": ["_lib/livekit/", "supabase/functions/livekit", "hooks/use-livekit"], "gates": ["assurance-state-model", "assurance-property", "assurance-concurrency", "livekit-authority", "assurance-installed-plan"]},
    {"match": [".github/", "package.json", "package-lock.json"], "gates": ["assurance-contracts", "assurance-pr-scope", "supply-chain", "assurance-final-summary"]}
  ],
  "riskCommands": {
    "A": ["node scripts/assurance/validate-contracts.mjs", "node scripts/assurance/current-truth.mjs", "node --test tests/assurance/github-main-ruleset-readback.test.mjs", "node --test tests/assurance/codex-review-exact-head.test.mjs", "git diff --check"],
    "B": ["npm run lint", "npm run typecheck", "node scripts/assurance/impact.mjs", "full Phase 1 CI at frozen head"],
    "C": ["all Level B commands", "applicable model/property/concurrency/native/provider/artifact gates", "four exact-head review lanes", "full Phase 1 CI at frozen head"],
    "D": ["separate owner-authorized task", "external confirmation when applicable"]
  }
}
