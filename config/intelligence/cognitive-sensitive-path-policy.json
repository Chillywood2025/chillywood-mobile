{
  "schemaVersion": 1,
  "policyId": "chillywood-cognitive-sensitive-path-v1",
  "unicodeNormalization": "NFKC",
  "caseInsensitive": true,
  "forbiddenSegments": [
    ".aws",
    ".azure",
    ".config/gcloud",
    ".config/gh",
    ".docker",
    ".git",
    ".gnupg",
    ".kube",
    ".ssh",
    "android",
    "credentials",
    "ios",
    "node_modules",
    "secrets",
    "serviceaccount",
    "tokens",
    "vault"
  ],
  "forbiddenBasenames": [
    ".env",
    ".envrc",
    ".git-credentials",
    ".htpasswd",
    ".netrc",
    ".npmrc",
    ".pypirc",
    ".pgpass",
    ".yarnrc",
    ".yarnrc.yml",
    ".yarnrc.yaml",
    "access_tokens.db",
    "application_default_credentials.json",
    "auth.json",
    "config.json",
    "credentials",
    "credentials.json",
    "credentials.toml",
    "credentials.tfrc.json",
    "id_dsa",
    "id_ecdsa",
    "id_ed25519",
    "id_rsa",
    "kubeconfig",
    "service-account.json",
    "serviceaccount.json",
    "token",
    "vault-token"
  ],
  "forbiddenExtensions": [
    ".bak",
    ".copy",
    ".jks",
    ".key",
    ".keystore",
    ".old",
    ".p12",
    ".p8",
    ".pem",
    ".swo",
    ".swp",
    ".tmp"
  ],
  "forbiddenNameFragments": [
    "access-token",
    "access_token",
    "client-secret",
    "client_secret",
    "firebase-admin",
    "github-token",
    "github_token",
    "npm-token",
    "npm_token",
    "private-key",
    "private_key",
    "refresh-token",
    "refresh_token",
    "service-account",
    "service_account",
    "yarn-token",
    "yarn_token"
  ],
  "rejectSymlinks": true,
  "rejectHardlinkedSensitiveFiles": true,
  "rejectSubmodules": true
}
