{
  "schemaVersion": 1,
  "policyId": "chillywood-cognitive-security-classification-v1",
  "normalization": {
    "unicodeForm": "NFKC",
    "stripDefaultIgnorables": true,
    "caseFoldLabels": true,
    "maximumDecodeDepth": 3,
    "maximumEncodedCandidateBytes": 4096
  },
  "limits": {
    "maximumDepth": 8,
    "maximumObjectKeys": 128,
    "maximumArrayLength": 128,
    "maximumStringBytes": 4000,
    "maximumTotalBytes": 16000,
    "maximumFragments": 128,
    "maximumClassificationMilliseconds": 5000
  },
  "secretLabels": [
    "access_token",
    "api_key",
    "authorization",
    "bearer",
    "client_secret",
    "cookie",
    "credential",
    "github_token",
    "key_password",
    "model_key",
    "password",
    "passphrase",
    "private_key",
    "refresh_token",
    "secret",
    "service_role",
    "session_cookie",
    "token"
  ],
  "providerAuthorityTerms": [
    "administrator",
    "assumerole",
    "attachuserpolicy",
    "cluster-admin",
    "clusterrolebindings",
    "contents:write",
    "editor",
    "impersonate",
    "notaction",
    "notresource",
    "owner",
    "poweruseraccess",
    "root",
    "setiampolicy",
    "system:masters",
    "tokencreator",
    "workflow:write",
    "workflows:write",
    "wildcard_allow"
  ],
  "privateIdentifierCategories": [
    "email",
    "phone",
    "private_ip",
    "session_identifier",
    "user_identifier"
  ],
  "fragmentReconstruction": {
    "positionAliases": ["index", "offset", "order", "ordinal", "position", "rank", "sequence", "slot"],
    "fragmentAliases": ["body", "chunk", "fragment", "head", "mid", "part", "payload", "tail", "value"],
    "semanticOrder": ["first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth"],
    "rejectDuplicatePositions": true,
    "inspectForwardAndReverse": true,
    "inspectObjectKeysAndValuesTogether": true
  },
  "safeStatusMetadata": [
    "active",
    "blocked",
    "cancelled",
    "complete",
    "disabled",
    "enabled",
    "expired",
    "inactive",
    "missing",
    "pending",
    "present",
    "rejected",
    "resolved",
    "revoked",
    "unknown"
  ],
  "forbiddenPrototypeKeys": ["__proto__", "constructor", "prototype"]
}
