{
  "schemaVersion": 1,
  "policyId": "chillywood-cognitive-network-v1",
  "allowedSchemes": ["https:"],
  "allowedPorts": ["", "443"],
  "maximumRedirects": 3,
  "maximumCompressedBytes": 1048576,
  "maximumDecompressedBytes": 4194304,
  "maximumDecompressionRatio": 20,
  "connectTimeoutMilliseconds": 5000,
  "readTimeoutMilliseconds": 10000,
  "totalTimeoutMilliseconds": 15000,
  "allowedContentTypes": [
    "application/json",
    "application/rss+xml",
    "application/xml",
    "text/html",
    "text/plain",
    "text/xml"
  ],
  "forbiddenHostSuffixes": [".internal", ".local", ".localhost"],
  "forbiddenHostnames": [
    "instance-data",
    "instance-data.ec2.internal",
    "metadata",
    "metadata.aws.internal",
    "metadata.google.internal",
    "localhost"
  ],
  "forbiddenCidrs": [
    "0.0.0.0/8",
    "10.0.0.0/8",
    "100.64.0.0/10",
    "127.0.0.0/8",
    "169.254.0.0/16",
    "172.16.0.0/12",
    "192.0.0.0/24",
    "192.0.2.0/24",
    "192.168.0.0/16",
    "198.18.0.0/15",
    "198.51.100.0/24",
    "203.0.113.0/24",
    "224.0.0.0/4",
    "240.0.0.0/4",
    "::/128",
    "::1/128",
    "64:ff9b:1::/48",
    "100::/64",
    "2001:db8::/32",
    "fc00::/7",
    "fe80::/10",
    "ff00::/8"
  ],
  "revalidateEveryRedirect": true,
  "pinResolvedAddresses": true,
  "verifyConnectedPeer": true,
  "sendCookies": false,
  "sendCredentials": false
}
