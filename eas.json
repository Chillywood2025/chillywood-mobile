{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-qa": {
      "extends": "production",
      "channel": "ios-qa",
      "distribution": "store",
      "environment": "production",
      "env": {
        "IOS_NATIVE_CALLS_ENABLED": "true",
        "IOS_QA_RUNTIME_VERSION": "1.0.0-iosqa1",
        "EXPO_PUBLIC_IOS_NATIVE_CALLS_ENABLED": "true",
        "EXPO_PUBLIC_IOS_ORDINARY_PUSH_ENABLED": "true",
        "EXPO_PUBLIC_REVENUECAT_APP_STORE_ENABLED": "true"
      }
    },
    "production-apk": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6791217176"
      }
    },
    "closed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
