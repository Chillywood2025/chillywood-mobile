{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production-v2",
      "distribution": "store",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "android-internal-v2": {
      "autoIncrement": true,
      "channel": "android-internal-v2",
      "distribution": "store",
      "environment": "production",
      "env": {
        "CHILLYWOOD_INTERNAL_V2_OTA_PLATFORM": "android"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "android-internal-device-v3": {
      "extends": "android-internal-v2",
      "distribution": "internal",
      "env": {
        "CHILLYWOOD_INTERNAL_V2_OTA_PLATFORM": "android"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ios-internal-v2": {
      "autoIncrement": true,
      "channel": "ios-internal-v2",
      "distribution": "store",
      "environment": "production",
      "env": {
        "CHILLYWOOD_INTERNAL_V2_OTA_PLATFORM": "ios",
        "IOS_NATIVE_CALLS_ENABLED": "true",
        "EXPO_PUBLIC_IOS_NATIVE_CALLS_ENABLED": "true",
        "EXPO_PUBLIC_IOS_ORDINARY_PUSH_ENABLED": "true",
        "EXPO_PUBLIC_REVENUECAT_APP_STORE_ENABLED": "true"
      }
    },
    "ios-internal-device-v3": {
      "extends": "ios-internal-v2",
      "distribution": "internal",
      "env": {
        "CHILLYWOOD_INTERNAL_V2_OTA_PLATFORM": "ios",
        "IOS_NATIVE_CALLS_ENABLED": "true",
        "EXPO_PUBLIC_IOS_NATIVE_CALLS_ENABLED": "true",
        "EXPO_PUBLIC_IOS_ORDINARY_PUSH_ENABLED": "true",
        "EXPO_PUBLIC_REVENUECAT_APP_STORE_ENABLED": "true"
      }
    },
    "android-production-local-recovery": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "android-chat-livekit-qa": {
      "extends": "production",
      "channel": "android-chat-livekit-qa",
      "distribution": "store",
      "environment": "production",
      "env": {
        "ANDROID_CHAT_LIVEKIT_QA_RUNTIME_VERSION": "1.0.0-android-chat-call-action-v1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "ios-qa": {
      "extends": "production",
      "channel": "ios-qa",
      "distribution": "store",
      "environment": "production",
      "env": {
        "IOS_NATIVE_CALLS_ENABLED": "true",
        "IOS_QA_RUNTIME_VERSION": "1.0.0-iosqa1",
        "EXPO_PUBLIC_IOS_NATIVE_CALLS_ENABLED": "true",
        "EXPO_PUBLIC_IOS_ORDINARY_PUSH_ENABLED": "true",
        "EXPO_PUBLIC_REVENUECAT_APP_STORE_ENABLED": "true"
      }
    },
    "production-apk": {
      "autoIncrement": false,
      "channel": "production-v2",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "android-internal-v2": {
      "android": {
        "track": "internal"
      }
    },
    "ios-internal-v2": {
      "ios": {
        "ascAppId": "6791217176",
        "groups": [
          "Chillywood Internal"
        ]
      }
    },
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6791217176"
      }
    },
    "closed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft"
      }
    }
  }
}
