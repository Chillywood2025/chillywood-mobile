  "findings": [
    {
      "severity": "P1",
      "id": "IOS_CONSUMED_NATIVE_CLAIM_EXPIRY_NOT_ENFORCED_AT_TRANSITION",
      "path": "_lib/communicationCallMediaPolicy.mjs",
      "finding": "The exact-head ownership policy validates a consumed claim's binding and generation but does not compare a current monotonic time with expiresAtMonotonicMs. The thread retains the consumed claim while asynchronous invite hydration runs, so transition authority can survive beyond the contract's 30-second TTL.",
      "requiredCorrection": "Require a finite monotonic time within the claim's consumed-at and expiry bounds both when ownership is derived and immediately before the transition request; add an executable delayed-consumption regression."
    },
    {
      "severity": "P1",
      "id": "D2C_MANDATORY_NEGATIVE_CONTROLS_NOT_PRODUCTION_BOUND",
      "path": "scripts/test-ios-native-call-route-provenance.mjs",
      "finding": "The reported 18/18 matrix toggles fields on an independent mutationDefaults object and maps them to error strings. Most fixture defaults are not derived from production source or executed variants, so production regressions can leave the 18/18 result green.",
      "requiredCorrection": "Bind every mandatory control to an executable production variant, source mutant, or focused guard whose result actually changes when the reviewed implementation is weakened."
    },
    {
      "severity": "P1",
      "id": "SHARED_PROVENANCE_PLATFORM_LIFECYCLE_CLEAR_NOT_ISOLATED",
      "path": "_lib/iosNativeCalls.ts",
      "finding": "The iOS readiness lifecycle calls clearNativeCallTransitionClaims(), which clears all platform claims. IosNativeCallsBridge is mounted on Android and startIosNativeCallsReadiness reaches this clear after not-iOS readiness resolution, so the future D2B Android producer can lose a trusted native-store claim during startup.",
      "requiredCorrection": "Make lifecycle clearing platform-scoped or prevent iOS readiness from mutating the registry on Android, add an Android-claim-survives-iOS-readiness regression, and include the callsite in the D2B reconciliation plan."
    },
    {
      "severity": "P1",
      "id": "IOS_TRUSTED_CLAIM_CREATOR_GUARD_NOT_REPOSITORY_WIDE",
      "path": "scripts/guard-ios-native-call-policy.mjs",
      "finding": "The sole-producer guard counts registerTrustedIosCallKitNativeEvent calls only inside app/_layout.tsx. Another production file can import and call the exported producer without failing the guard.",
      "requiredCorrection": "Scan tracked production source repository-wide with an exact creator allowlist and prove an additional creator callsite fails the gate."
    },
    {
      "severity": "P2",
      "id": "IOS_PENDING_NATIVE_EVENT_DURABLE_TIMESTAMP_GENERATION_DEFERRED",
      "assignedSuccessor": "D3",
      "finding": "Native pending events do not yet carry a durable native timestamp and generation suitable for stronger process-recovery attestation."
    },
    {
      "severity": "P2",
      "id": "IOS_CALLKIT_COMPLETION_RESULT_ATTESTATION_DEFERRED",
      "assignedSuccessor": "D3",
      "finding": "The native completion result is not independently attested beyond the current bridge return path."
    },
    {
      "severity": "P2",
      "id": "IOS_AUDIO_EVENT_NATIVE_IDENTITY_SCOPE_DEFERRED",
      "assignedSuccessor": "D3",
      "finding": "The existing audioSessionActivated path is not fully scoped to one native call UUID."
    }
  ],
