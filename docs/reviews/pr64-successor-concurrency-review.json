  "findings": [
    {
      "id": "PR64_SUCCESSOR_EMPTY_OR_BARE_MODEL_OPTIONS_DO_NOT_FAIL_CLOSED",
      "severity": "P2",
      "status": "open",
      "locations": [
        "scripts/assurance/models/run.mjs:9",
        "scripts/assurance/models/run.mjs:17",
        "scripts/assurance/models/run.mjs:23",
        "scripts/assurance/models/run.mjs:31",
        "scripts/assurance/models/run.mjs:53"
      ],
      "evidence": "Three explicit malformed invocations exit 0 with MODEL_CLEAR: --domain= is treated as no domain and runs all six models; a bare --seed is represented as boolean true and coerced to numeric seed 1; --path= is treated as no replay path. The output requestIdentity is null for the empty domain/path cases and reports seed \"true\" while executing seed 1 for the bare seed case.",
      "impact": "A caller-supplied filter or replay identity can still be silently discarded or changed while the command reports MODEL_CLEAR. This is a narrow continuation of the prior fail-closed CLI finding at option-presence boundaries.",
      "requiredResolution": "Validate option presence separately from truthiness. Reject an empty domain or replay path, reject non-string or missing-value numeric options before Number conversion, and add nonzero child-process regressions for --domain=, --path=, and bare --seed."
    }
  ],
