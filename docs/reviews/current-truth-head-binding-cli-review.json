  "findings": [
    {
      "id": "CURRENT_TRUTH_SYMBOLIC_ORIGIN_HEAD_SUBSTITUTION",
      "severity": "P1",
      "status": "open",
      "locations": [
        "scripts/assurance/lib.mjs:75",
        "scripts/assurance/lib.mjs:90",
        "config/assurance/schemas-v1.json:8",
        "tests/assurance/current-truth-head-binding.test.mjs:38"
      ],
      "evidence": "The runtime and JSON-schema branch validators accept the literal branch HEAD. implementationRemoteRef then constructs refs/remotes/origin/HEAD, whose symbolic target is origin/main. A synthetic open implementation record using branch HEAD and the origin/main hash returned ok=true with no findings, while git check-ref-format --branch HEAD returned nonzero.",
      "impact": "A malformed current-truth entry can substitute the default-branch symbolic ref for an implementation branch and falsely report exact implementation-head alignment.",
      "requiredResolution": "Reject HEAD and any other Git pseudo-ref that cannot be an unambiguous branch in both the schema and runtime validator, and add a regression case proving it emits ASSURANCE_CURRENT_TRUTH_IMPLEMENTATION_BRANCH_MALFORMED without dereferencing origin/HEAD."
    },
    {
      "id": "CURRENT_TRUTH_NAMED_MAIN_CHECKOUT_HEAD_UNBOUND",
      "severity": "P1",
      "status": "open",
      "locations": [
        "scripts/assurance/lib.mjs:175",
        "scripts/assurance/lib.mjs:224",
        "scripts/assurance/current-truth.mjs:86",
        "tests/assurance/current-truth-head-binding.test.mjs:38"
      ],
      "evidence": "verifyCurrentTruthHeadBindings returned ok=true and context=main for branch=main when checkout head and remoteMain were distinct valid SHAs. The CLI's mainMatches expression also short-circuits on branch === main, so the stale named-main checkout is not rejected.",
      "impact": "The guard can return a top-level pass while running code from a stale or foreign local main checkout, despite having the exact origin/main hash available.",
      "requiredResolution": "Require a named main checkout head to equal remoteMain and emit ASSURANCE_CURRENT_TRUTH_CHECKOUT_HEAD_STALE when it does not. Retain merge-base behavior only for non-main control or implementation branches, and cover both behind and ahead named-main cases."
    },
    {
      "id": "CURRENT_TRUTH_SCHEMA_RUNTIME_SHAPE_DRIFT",
      "severity": "P2",
      "status": "open",
      "locations": [
        "config/assurance/schemas-v1.json:8",
        "config/assurance/schemas-v1.json:100",
        "scripts/assurance/lib.mjs:72",
        "scripts/assurance/lib.mjs:123"
      ],
      "evidence": "The schema branch pattern accepts ASCII tab even though the runtime rejects it, and the PR number schema accepts any JavaScript number while runtime requires a positive integer.",
      "impact": "Contract validation can approve records that the CLI later rejects, weakening schema-first diagnostics and making behavior depend on which assurance command runs first.",
      "requiredResolution": "Align schema and runtime branch constraints, encode a positive integer PR number, and extend the local schema validator to enforce integer/minimum if those JSON Schema keywords are introduced."
    },
    {
      "id": "CURRENT_TRUTH_UNLISTED_IMPLEMENTATION_DISCOVERY_DEFERRED",
      "severity": "P2",
      "status": "open",
      "locations": [
        "config/assurance/current-truth-contract-v1.json:43",
        "scripts/assurance/current-truth.mjs:101",
        "scripts/assurance/lib.mjs:238"
      ],
      "evidence": "The guard deliberately validates only entries already present in openImplementationPrs, reports unlistedBranchPolicy=deferred-to-pr-e, and read-only snapshot comparison does not include openImplementationPrs or openReviewOnlyPrs.",
      "impact": "A listed PR advancing is detected, but omission of an open implementation or review PR is not yet detectable by this bounded offline guard.",
      "requiredResolution": "Complete the declared PR E discovery policy by comparing sanitized read-only GitHub snapshot inventories and explicit CI PR context to the record; keep network access outside this offline command."
    }
  ],
