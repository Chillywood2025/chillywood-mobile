  "findings": [
    {
      "id": "PR64_NOTIFICATION_MODEL_MISATTRIBUTES_PUSHKIT_COVERAGE_TO_FCM",
      "severity": "P1",
      "status": "open",
      "locations": [
        "_lib/assurance/state-models/models.mjs:418",
        "_lib/assurance/state-models/models.mjs:420",
        "_lib/assurance/state-models/models.mjs:641",
        "config/assurance/feature-registry-v1.json:66",
        "config/assurance/feature-registry-v1.json:75"
      ],
      "evidence": "notification-native-action models APNs acceptance, PushKit must-report handling, CallKit reporting, native Answer/Decline retention, and server acceptance, but its featureId is notifications-fcm. That registered feature is Android/iOS non-VoIP delivery with enqueue/send/retry/open/expire, preference, privacy, and token-lifecycle requirements. pushkit-callkit is a separate iOS feature with T2 required, yet it has no model result and appears only as a T6 higher-tier blocker.",
      "impact": "A report can assign MODEL_CLEAR to notifications-fcm without modeling its declared behavior while leaving the required pushkit-callkit T2 gate structurally unbound. This is both a false feature-clear and a missing model result.",
      "requiredResolution": "Bind the current native-action model to pushkit-callkit, add a separately scoped FCM delivery model before granting notifications-fcm MODEL_CLEAR, and add a contract validator that fails when a required-T2 feature is absent or a model's declared behavior does not match its registered feature."
    },
    {
      "id": "PR64_IMPACT_PLANNER_OMITS_MODEL_GATES_FOR_MODEL_SOURCE",
      "severity": "P1",
      "status": "open",
      "locations": [
        "config/assurance/test-impact-map-v1.json:7",
        "config/assurance/test-impact-map-v1.json:12",
        "scripts/assurance/impact.mjs:6"
      ],
      "evidence": "Against the exact ten-file PR delta, assurance:impact reports ok=true but requires only contract/current-truth/review/scope/link/diff/supply-chain/final gates. It omits assurance-state-model, assurance-property, and assurance-concurrency for changes under _lib/assurance/state-models, scripts/assurance/models, and tests/assurance/{property,concurrency}. Supplying any of the seven reviewed feature IDs still produces the same deficient gate list.",
      "impact": "A future change to the assurance models or their tests can be planned as successful without running the gates that validate the changed logic. The final required-job matrix would be unable to distinguish an applicable gate that never ran.",
      "requiredResolution": "Add exact impact rules for model source, runner, property tests, concurrency tests, and escaped-defect fixtures; require state-model/property/concurrency gates; make feature selection contribute the registered feature's tier requirements; and add fail-closed regression tests using this PR's changed-file set."
    },
    {
      "id": "PR64_MODEL_TRANSITION_COVERAGE_NOT_CROSSCHECKED_WITH_REGISTRY",
      "severity": "P2",
      "status": "open",
      "locations": [
        "_lib/assurance/state-models/properties.mjs:5",
        "scripts/assurance/validate-contracts.mjs:1",
        "config/assurance/feature-registry-v1.json:1"
      ],
      "evidence": "Each model has one positive witness, but no machine check compares model commands, states, invariants, or witnesses with the registered feature's declared transitions and invariants. Contract validation passes despite the notification/PushKit mismatch and despite multiple declared transitions having no positive or negative witness.",
      "impact": "Registry or model changes can silently reduce transition coverage while preserving schema validity and MODEL_CLEAR for the remaining happy path.",
      "requiredResolution": "Add stable model-to-feature coverage metadata and validate every required transition/invariant as modeled, delegated to a named higher tier, or explicitly not applicable."
    },
    {
      "id": "PR64_FROZEN_HEAD_PHASE1_CI_PENDING",
      "severity": "P2",
      "status": "pending",
      "evidence": "This isolated architecture review was explicitly limited to focused contract, impact, proof-strength, scope, and boundary checks.",
      "requiredResolution": "After remediation and all exact-head reviews, the coordinator runs one full Phase 1 CI execution at the frozen implementation head."
    }
  ],
