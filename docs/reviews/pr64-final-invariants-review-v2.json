      "id": "PR64_PERSISTED_REPLAY_IDENTIFIER_REDACTION_INCOMPLETE",
      "severity": "P1",
      "status": "open",
      "locations": [
        "scripts/assurance/models/run.mjs:13",
        "scripts/assurance/models/run.mjs:17",
        "scripts/assurance/models/run.mjs:56",
        "scripts/assurance/models/run.mjs:83",
