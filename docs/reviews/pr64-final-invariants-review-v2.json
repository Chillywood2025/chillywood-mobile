        "_lib/assurance/state-models/models.mjs:660",
        "_lib/assurance/state-models/models.mjs:661",
        "_lib/assurance/state-models/models.mjs:692"
      ],
      "evidence": "All 22 present fixtures detect their historical variant and pass the fixed model. Several explicit detector branches still have no targeted historical/fixed fixture, including LiveKit duplicate room/track, fixture-as-real pass, terminal cleanup, and migration deployed-body rewrite, RLS/FORCE RLS loss, and broad grant.",
      "impact": "Property runs prove reachable fixed states, but these fixed transitions cannot create the forbidden states. Removing or inverting the named detector branches would not necessarily fail the current historical fixture corpus before PR E mutation enforcement exists.",
      "requiredResolution": "Add minimized historical variants and fixed-model regressions for the named detector branches, or bind equivalent killed mutants before declaring those branches reusable escaped-defect prevention evidence.",
      "blocksMerge": false
    },
