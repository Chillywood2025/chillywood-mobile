        "scripts/assurance/lib.mjs:40",
        "scripts/assurance/lib.mjs:42",
        "tests/assurance/models/escaped-defects.test.mjs:83",
        "tests/assurance/models/escaped-defects.test.mjs:100"
      ],
      "evidence": "The remediation applies the repository's generic redact function before persistence. The hostile regression proves a token-shaped marker is removed, mode 0600 is used, and an existing file is not clobbered. An independent adversarial run used a synthetic device-identifier-shaped value as an unknown --domain. safeIdentity accepted it, the generic string redactor did not recognize it, and the exact marker remained in both stdout request/finding fields and the persisted replay. The run failed as expected, but its private-identifier evidence boundary did not fail closed.",
      "impact": "The assurance runner can print and persist a device- or account-identifier-shaped CLI value even though the root contract forbids raw device/account identifiers and requires contract-approved hashes or summaries. Generic secret-pattern replacement is not a bounded persistence allowlist.",
      "requiredResolution": "Validate domain against the finite model registry before it reaches requestIdentity or a model error, persist only an explicit replay-evidence allowlist, hash or omit non-enumerated identities, add adversarial device/account/UUID-shaped cases, and prove neither stdout nor persisted evidence contains the marker. Retain 0600 and wx no-clobber behavior.",
      "blocksMerge": true
    },
    {
      "id": "PR64_OTA_NEW_SOURCE_UPDATE_TRANSITION_NOT_REPRESENTED",
      "severity": "P2",
      "status": "open",
      "locations": [
        "_lib/assurance/state-models/models.mjs:371",
        "_lib/assurance/state-models/models.mjs:378",
        "_lib/assurance/state-models/models.mjs:425",
        "_lib/assurance/state-models/properties.mjs:10",
        "tests/assurance/models/escaped-defects.test.mjs:58"
      ],
      "evidence": "The compatibility predicate requires build.sourceCommit to equal update.sourceCommit. The positive witness therefore reactivates source-a on a source-a build. An otherwise compatible source-b update is rejected with currentUpdate=null and activationRejected=1 without an invariant violation.",
      "impact": "The T2 witness proves equality enforcement, but does not represent a real new-source OTA bound to its own source identity and a target build identity. The model cannot distinguish correct per-artifact source binding from an incompatible native/runtime update.",
      "requiredResolution": "Model build source, update source, and target-build identity separately; bind each manifest to its own source; retain exact runtime, platform, environment, channel, native digest, capability, embedded, and rollback constraints; add a positive new-source OTA witness.",
      "blocksMerge": false
    },
    {
      "id": "PR64_INVARIANT_DETECTOR_HISTORICAL_COVERAGE_REMAINS_PARTIAL",
      "severity": "P2",
      "status": "open",
      "locations": [
        "_lib/assurance/state-models/models.mjs:593",
        "_lib/assurance/state-models/models.mjs:597",
        "_lib/assurance/state-models/models.mjs:598",
