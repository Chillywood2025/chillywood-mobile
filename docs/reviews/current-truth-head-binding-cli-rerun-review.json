  "findings": [
    {
      "id": "CURRENT_TRUTH_DETACHED_EXPLICIT_MAIN_HEAD_BYPASS",
      "severity": "P1",
      "status": "open",
      "locations": [
        "scripts/assurance/lib.mjs:288",
        "scripts/assurance/lib.mjs:318",
        "scripts/assurance/lib.mjs:320",
        "scripts/assurance/current-truth.mjs:87",
        "tests/assurance/current-truth-head-binding.test.mjs:115"
      ],
      "evidence": "A detached context with head set to a feature commit, remoteMain set to a different SHA, explicitBranch=main, and explicitHead equal to the feature commit returned ok=true, context=unlisted-control-branch, and no findings. The named-main comparison checks namedBranch only. In the CLI, an ordinary feature commit based on origin/main also satisfies the non-main merge-base branch of mainMatches.",
      "impact": "Detached CI can label a feature checkout as main and receive a top-level current-truth pass without the checkout equaling origin/main, bypassing the exact main-head invariant the correction intends to enforce.",
      "requiredResolution": "Apply origin/main exactness to the effective context branch after explicit-context validation, not only to namedBranch. Reject explicit main whenever head differs from remoteMain, and add unit plus detached-CLI regression cases for exact, ahead, and behind explicit-main heads."
    },
    {
      "id": "CURRENT_TRUTH_CONTRACT_VALIDATOR_IGNORES_INTEGER_MINIMUM",
      "severity": "P2",
      "status": "open",
      "locations": [
        "config/assurance/schemas-v1.json:103",
        "scripts/assurance/validate-contracts.mjs:31",
        "scripts/assurance/validate-contracts.mjs:33",
        "tests/assurance/current-truth-head-binding.test.mjs:195"
      ],
      "evidence": "The schema now declares number as type integer with minimum 1, and both runtime paths reject 0, negative, fractional, string, and null values. The repository's schema validator implements type number and maximum only; it has no integer type or minimum handling. The committed test asserts the schema object shape rather than exercising contract rejection.",
      "impact": "Runtime gates fail closed, but assurance:validate-contracts can still approve a malformed PR number, so the machine-readable schema contract is not independently enforced.",
      "requiredResolution": "Teach the local validator to enforce integer and minimum, then add hostile contract fixtures proving zero, negative, fractional, string, and null PR numbers are rejected."
    },
    {
      "id": "CURRENT_TRUTH_PROVIDER_SNAPSHOT_PARSE_FAILURE_NOT_MACHINE_JSON",
      "severity": "P2",
      "status": "open",
      "locations": [
        "scripts/assurance/current-truth.mjs:99"
      ],
      "evidence": "A read-only provider snapshot containing invalid JSON exited nonzero but emitted no machine JSON and exposed a JSON.parse stack on stderr. Shape-invalid but parseable inventory correctly emitted structured findings.",
      "impact": "The gate is fail-closed, but malformed evidence breaks the assurance command's machine-readable output contract and makes CI aggregation depend on parsing an exception.",
      "requiredResolution": "Catch snapshot file/read/parse failures and emit one redacted BLOCKED_INTERNAL finding such as ASSURANCE_PROVIDER_SNAPSHOT_MALFORMED without a stack trace."
    }
  ],
