  "findings": [
    {
      "id": "CURRENT_TRUTH_HEAD_BINDING_TEST_DETACHED_CHECKOUT_DEPENDENCY",
      "severity": "P1",
      "status": "open",
      "locations": [
        "tests/assurance/current-truth-head-binding.test.mjs:238",
        "tests/assurance/current-truth-head-binding.test.mjs:252"
      ],
      "evidence": "The focused test passes in a named local branch. In a local shared clone checked out detached at exact implementation head 66d024103a2791160214f4d03e7db5c67b7073fa, the same command exited 1 at line 252: payload.headBindings.ok was false while the test expected true. runSnapshotCli invokes current-truth read-only without explicit implementation branch/head, so the runtime correctly classifies detached non-main context as unresolved before the test asserts that only the provider inventory failed.",
      "impact": "The committed focused assurance gate is checkout-context-dependent and fails under the detached checkout normally used by pull-request CI. It therefore cannot supply deterministic exact-head evidence or be safely wired into PR E CI in its current form.",
      "requiredResolution": "Make runSnapshotCli pass an explicit deterministic branch/head matching its actual checkout context, or qualify the provider assertion so unrelated detached-context findings cannot invalidate the provider corpus. Prove the full focused test passes from both named and detached exact-head checkouts with the same provider outcomes."
    },
    {
      "id": "CURRENT_TRUTH_CONTRACT_VALIDATOR_INTEGER_MINIMUM_DEFERRED",
      "severity": "P2",
      "status": "open-routed-pr-e",
      "locations": [
        "config/assurance/schemas-v1.json:103",
        "scripts/assurance/validate-contracts.mjs:31",
        "scripts/assurance/validate-contracts.mjs:33"
      ],
      "evidence": "The current-truth schema declares a positive integer and runtime validation rejects malformed PR numbers, but the foundation's general custom schema validator does not yet implement integer or minimum keywords.",
      "impact": "Runtime current-truth and provider inventory gates fail closed; standalone schema-validation coverage remains incomplete for these general keywords.",
      "requiredResolution": "Complete the already-routed PR E validator hardening with integer and minimum support and hostile contract fixtures; do not expand PR #90 for this nonblocking general-validator task."
    }
  ],
