  "findings": [
    {
      "id": "UNCLASSIFIED_ASSURANCE_MODEL_SOURCE",
      "severity": "P1",
      "status": "open",
      "affectedPaths": [
        "config/assurance/pr-scope-policy-v1.json",
        "_lib/assurance/state-models/concurrency.mjs",
        "_lib/assurance/state-models/models.mjs",
        "_lib/assurance/state-models/properties.mjs"
      ],
      "evidence": "The exact-base pr-scope command returns PASS, but all three _lib/assurance/state-models files have an empty domain list. Those files contain 914 of 1060 added lines (86.2%), while the PR body describes all nine files as CI/test infrastructure. The supporting-domain policy lists scripts, tests, package files, workflows, and config/assurance but not _lib/assurance, and the gate does not reject unclassified source.",
      "impact": "The mandatory scope gate does not classify most of this PR and can be made to pass because unrelated package/scripts/tests provide a supporting-domain label. That is not fail-closed and leaves a path for assurance or implementation source to evade the declared-domain contract.",
      "requiredResolution": "Classify the exact _lib/assurance path as CI-test-infrastructure and make any unclassified changed source a blocking finding. Add a regression proving an assurance-source-only diff is classified and proving unrelated supporting files cannot conceal an unclassified source path. Freeze a new implementation head and rerun all exact-head reviews."
    },
    {
      "id": "REPLAY_OUTPUT_CAN_CLOBBER_EXISTING_PATH",
      "severity": "P2",
      "status": "open",
      "affectedPaths": [
        "scripts/assurance/models/run.mjs"
      ],
      "evidence": "On a failing model run, lines 45-49 resolve any caller-supplied replayOutput and write it with writeFileSync without restricting the evidence root, rejecting symlinks, or refusing an existing file.",
      "impact": "A mistyped local replay path can overwrite an unrelated writable file exactly when failure evidence is being preserved. This does not expose a provider or secret, but it weakens the review-safe evidence path.",
      "requiredResolution": "In a bounded successor, constrain replay evidence to an approved private evidence directory or implement explicit no-clobber and symlink-safe semantics with focused tests."
    },
    {
      "id": "FAST_CHECK_DEV_ONLY_DEPENDENCY_BOUNDARY",
