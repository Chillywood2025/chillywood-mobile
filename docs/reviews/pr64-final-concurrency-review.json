  "findings": [
    {
      "id": "PR64_REQUIRED_INTERLEAVING_ASSERTIONS_ARE_MUTATION_VACUOUS",
      "severity": "P1",
      "status": "open",
      "locations": [
        "_lib/assurance/state-models/concurrency.mjs:88",
        "_lib/assurance/state-models/concurrency.mjs:156",
        "_lib/assurance/state-models/concurrency.mjs:165",
        "tests/assurance/concurrency/interleavings.test.mjs:5"
      ],
      "evidence": "Eight in-memory deletion/guard-removal probes still return MODEL_CLEAR: either resolver can be removed from accept-timeout and accept-cancel, OTA activate or rollback can be removed, the emergency mutation can be removed, and mutation can ignore the stopped guard. The test asserts scenario counts/statuses but not the required final state for these schedules.",
      "impact": "The gate can remain green after losing required acceptance, timeout, cancellation, activation, rollback, or emergency-stop denial behavior. Twenty schedules therefore do not provide fail-closed assurance for three of the mandated race families.",
      "requiredResolution": "Assert the exact expected final state for both orders of every scenario. Require the first atomic resolver to win accept-timeout/cancel, require rollback and activation order semantics explicitly, and require mutation-after-stop to be denied while a pre-stop mutation is counted. Add deletion-mutant regressions."
    },
    {
      "id": "PR64_MUST_REPORT_PUSH_CAN_ACCEPT_WITHOUT_CALLKIT_OR_COMPLETION",
      "severity": "P1",
      "status": "open",
      "locations": [
        "_lib/assurance/state-models/models.mjs:449",
        "_lib/assurance/state-models/models.mjs:483",
        "_lib/assurance/state-models/models.mjs:508",
        "_lib/assurance/state-models/properties.mjs:9"
      ],
      "evidence": "A deterministic receive_push(mustReport=true) -> native Answer -> auth/React ready -> consume -> server_accept sequence ends accepted with no CallKit report, no push completion, and zero violations.",
      "impact": "MODEL_CLEAR permits the exact proof substitution the native notification model is meant to reject: server acceptance can hide an unmet PushKit must-report lifecycle obligation.",
      "requiredResolution": "Make accepted a must-report obligation evaluation point or require obligationsClear before server_accept. Add a positive receive/report/complete/Answer witness and a negative Answer-without-report/completion regression."
    },
    {
      "id": "PR64_CANONICAL_ESCAPED_DEFECT_VARIANTS_INCOMPLETE",
      "severity": "P1",
      "status": "open",
      "locations": [
        "config/assurance/escaped-defect-catalog-v1.json",
        "_lib/assurance/state-models/models.mjs:648",
        "tests/assurance/models/escaped-defects.test.mjs:9"
      ],
      "evidence": "The declared suite passes 13/13 fixtures, but only 10 of 17 canonical defect IDs whose affected domains intersect the six modeled domains have historical/current variants. Seven canonical IDs are absent, while three passing fixture IDs are not in the canonical catalog.",
      "impact": "The 13/13 total can be read as escaped-defect closure even though EAS environment override, missing native module, double-serialized JSONB, platform scope, PushKit delivery suppression, LiveKit media without UI resolution, and migration version/name mismatch are not replayed.",
      "requiredResolution": "Add historical/current variants for every applicable canonical defect or encode a machine-readable, reviewed NOT_APPLICABLE mapping per missing ID. Report canonical coverage separately from supplemental fixture coverage."
    },
    {
      "id": "PR64_REPLAY_SEED_AND_CONCURRENCY_DOMAIN_OPTIONS_SILENTLY_IGNORED",
      "severity": "P2",
      "status": "open",
      "locations": [
        "scripts/assurance/models/run.mjs:12",
        "scripts/assurance/models/run.mjs:33",
        "scripts/assurance/models/run.mjs:36",
        "scripts/assurance/models/run.mjs:39"
      ],
      "evidence": "--suite=property --seed=999 without --domain exits 0 but uses all six default seeds and is byte-identical to the default output. --suite=concurrency --domain=chat-call exits 0 but runs all 10 scenarios and is byte-identical to the unfiltered output.",
      "impact": "Caller-supplied replay/filter intent can be ignored while the command reports MODEL_CLEAR. The actual seeds and counts are visible in JSON, but the command does not fail closed on unsupported option combinations.",
      "requiredResolution": "Reject seed without a property domain and reject or implement domain filtering for concurrency. Add nonzero CLI regressions for unsupported option combinations."
    }
