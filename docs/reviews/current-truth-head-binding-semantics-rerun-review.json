  "findings": [
    {
      "id": "CURRENT_TRUTH_NAMED_MAIN_CHECKOUT_UNBOUND",
      "severity": "P1",
      "status": "resolved",
      "resolution": "Both the helper and CLI now require a named main checkout to equal origin/main. Behind and ahead probes emit ASSURANCE_CURRENT_TRUTH_MAIN_CHECKOUT_STALE, while detached exact main remains accepted."
    },
    {
      "id": "CURRENT_TRUTH_DETACHED_EXPLICIT_MAIN_ALIAS_BYPASS",
      "severity": "P1",
      "status": "open",
      "affectedPaths": [
        "scripts/assurance/current-truth.mjs",
        "scripts/assurance/lib.mjs",
        "tests/assurance/current-truth-head-binding.test.mjs"
      ],
      "evidence": "With a detached checkout at feature head b...b, origin/main a...a, explicitBranch=main, and explicitHead=b...b, verifyCurrentTruthHeadBindings returns ok=true, context=unlisted-control-branch, and no findings. The actual PR #90 feature head has merge-base equal to origin/main, so current-truth.mjs also considers mainMatches true for this detached context.",
      "impact": "Detached CI can label a feature commit as main and obtain a current-truth pass without HEAD equaling origin/main. This bypasses the remediated exact-main invariant and permits stale or unmerged source to masquerade as authoritative main.",
      "requiredResolution": "Treat contextBranch=main identically whether it comes from the named checkout or explicitBranch: require checkout HEAD exactly equal to origin/main, reject an explicit main alias at any other head, and add helper plus detached CLI regression coverage."
    },
    {
      "id": "CURRENT_TRUTH_PROVIDER_SNAPSHOT_IGNORES_IMPLEMENTATION_HEADS",
      "severity": "P1",
      "status": "resolved",
      "resolution": "Read-only mode now normalizes and exactly compares provider implementation number, branch, head, and state. Missing, extra, duplicate, malformed, and mismatched entries block with machine-readable findings; reordered exact evidence passes."
    },
    {
      "id": "PROVIDER_SNAPSHOT_MALFORMED_INPUT_REPORTING",
      "severity": "P2",
      "status": "open",
      "affectedPaths": [
        "scripts/assurance/current-truth.mjs",
        "scripts/assurance/lib.mjs",
        "config/assurance/schemas-v1.json",
        "tests/assurance/current-truth-head-binding.test.mjs"
      ],
      "evidence": "A snapshot whose JSON root is null exits nonzero through an uncaught property-access error and emits no machine-readable assurance payload. Separately, state validation accepts a whitespace-only string, and the record schema has no state minLength or enumerated vocabulary.",
      "impact": "These cases do not recreate either prior stale-head false pass for the current valid record, but malformed external evidence is not reported through the required deterministic machine-readable contract and a semantically empty state can be normalized as valid.",
      "requiredResolution": "In a bounded follow-up, validate the snapshot root before property access, emit a stable BLOCKED_INTERNAL JSON finding for unreadable or malformed snapshot roots, and require a trimmed nonempty or contract-enumerated implementation state in both runtime and schema tests."
    },
    {
      "id": "UNLISTED_CONTROL_BRANCH_POLICY_DEFERRED",
      "severity": "P2",
      "status": "pending",
      "resolution": "Self-reference remains nonblocking for this review-only branch. Completeness enforcement for unlisted implementation branches is explicitly deferred to PR E and is not represented as live provider proof."
    }
  ],
