  "findings": [
    {
      "id": "MODEL_REPLAY_PERSISTENCE_BYPASSES_SECRET_REDACTION",
      "severity": "P1",
      "status": "open",
      "locations": [
        "scripts/assurance/models/run.mjs:13",
        "scripts/assurance/models/run.mjs:17",
        "scripts/assurance/models/run.mjs:62",
        "scripts/assurance/models/run.mjs:84"
      ],
      "evidence": "The successor retains requestIdentity in the model payload, then writes stableJson(payload) directly to replay evidence before emit() applies the shared redaction layer. A disposable exact-head probe using a synthetic GitHub-token-shaped unknown domain produced redacted stdout but wrote the raw marker twice into the mode-0600 replay JSON.",
      "impact": "A token, credential-shaped identifier, email, device identifier, or other sensitive CLI input can be preserved in assurance evidence even though console output is redacted. The file is private by mode but remains raw evidence that can be retained, uploaded, or committed accidentally, violating the assurance secret and evidence boundary.",
      "requiredResolution": "Redact the entire payload before replay persistence or retain only an allowlisted known domain plus a non-reversible hash for rejected input. Add a hostile test that reads the persisted file and proves synthetic secrets, emails, and device identifiers are absent while valid replay path identity remains usable. Freeze a new implementation head and rerun impacted security and replay reviews."
    },
    {
      "id": "PR64_CURRENT_MAIN_ANCESTRY_AND_CURRENT_TRUTH_REGRESSION",
      "severity": "P1",
      "status": "resolved",
