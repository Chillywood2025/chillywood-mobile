[Service]
# systemd materializes LoadCredential files for fixed User= services as
# root:root 0440. The reviewed Node entrypoint intentionally rejects every
# credential with group/world permission bits. Keep the persistent source
# root-only, then copy it at service start into a private ephemeral directory
# as the dedicated service identity with mode 0400. Keep that runtime directory
# outside systemd's special /run/credentials namespace.
LoadCredential=
RuntimeDirectory=chillywood-research-transport-runtime
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/bin/install -o chillywood-research-transport -g chillywood-research-transport -m 0400 /etc/chillywood/research-transport/research_transport_hmac /run/chillywood-research-transport-runtime/research_transport_hmac
ExecStopPost=+/usr/bin/rm -f -- /run/chillywood-research-transport-runtime/research_transport_hmac
Environment=COGNITIVE_RESEARCH_TRANSPORT_CREDENTIAL_BOUNDARY=systemd-fixed-user-ephemeral-0400-v1
Environment=CREDENTIALS_DIRECTORY=/run/chillywood-research-transport-runtime
