{
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": false,
  "workers_dev": false,
  "hyperdrive": [
    {
      "binding": "COGNITIVE_LIVEKIT_EXPERIENCE_COLLECTOR_HYPERDRIVE",
      "id": "REPLACE_WITH_COGNITIVE_LIVEKIT_EXPERIENCE_COLLECTOR_HYPERDRIVE_ID"
    }
  ],
  "main": "../entrypoints/cognitive_livekit_experience_collector.mjs",
  "name": "chillywood-level01-livekit-experience-collector",
  "secrets": {
    "required": [
      "COGNITIVE_LIVEKIT_EXPERIENCE_COLLECTOR_INVOKE_SHA256",
      "COGNITIVE_LIVEKIT_SENTINEL_ASSERTION",
      "LIVEKIT_API_KEY",
      "LIVEKIT_API_SECRET"
    ]
  },
  "vars": {
    "RUNTIME_SCHEMA_VERSION": "cognitive-level01-isolated-runtime-v1",
    "SOURCE_COMMIT": "REPLACE_WITH_REVIEWED_SUCCESSOR_COMMIT",
    "SOURCE_BASE_COMMIT": "8660558a9cf360f033246a404dfc5812d522da88"
  },
  "version_metadata": {
    "binding": "WORKER_VERSION"
  }
}
