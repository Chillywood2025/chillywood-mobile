[Unit]
Description=Chi'llywood Release / OTA operator watch_once probe
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/chillywood/release-operator.env
Environment=OPERATOR_SCHEDULER=systemd_timer
Environment=OPERATOR_ID=release_ota_operator
Environment=OPERATOR_SOURCE=systemd_timer:chillywood-prod-01:release_ota_operator
ExecStart=/opt/chillywood/release-operator/release-operator-watch-once.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
