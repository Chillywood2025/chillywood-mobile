[Unit]
Description=Chi'llywood Support Success operator watch_once probe
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/chillywood/support-success-operator.env
Environment=OPERATOR_SCHEDULER=systemd_timer
Environment=OPERATOR_ID=support_success_operator
Environment=OPERATOR_SOURCE=systemd_timer:chillywood-prod-01:support_success_operator
ExecStart=/opt/chillywood/support-success-operator/support-success-operator-watch-once.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
