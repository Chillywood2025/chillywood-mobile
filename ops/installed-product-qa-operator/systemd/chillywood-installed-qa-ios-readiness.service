[Unit]
Description=Chi'llywood installed_product_qa_operator iOS source/provider readiness
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/chillywood/installed-product-qa-operator.env
ExecStart=/opt/chillywood/installed-product-qa-operator/installed-qa-ios-readiness.sh
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
