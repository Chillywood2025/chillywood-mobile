[Unit]
Description=Chi'llywood Money operator provider-health watch_once probe
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/chillywood/money-operator.env
Environment=OPERATOR_SCHEDULER=systemd_timer
Environment=OPERATOR_ID=money_flow_control
Environment=OPERATOR_SOURCE=systemd_timer:chillywood-prod-01:money_flow_control
ExecStart=/opt/chillywood/money-operator/money-operator-watch-once.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
