[Unit]
Description=Chi'llywood Privacy Compliance operator watch_once probe
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/chillywood/privacy-compliance-operator.env
Environment=OPERATOR_SCHEDULER=systemd_timer
Environment=OPERATOR_ID=privacy_compliance_operator
Environment=OPERATOR_SOURCE=systemd_timer:chillywood-prod-01:privacy_compliance_operator
ExecStart=/opt/chillywood/privacy-compliance-operator/privacy-compliance-operator-watch-once.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
