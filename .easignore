/ios
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
ios/build/

# Local machine/editor noise
.DS_Store
*.tsbuildinfo

# Local-only env files and signing material
.env*.local
app-store-connect.env
app-store-connect.*.env
!app-store-connect.example.env
!app-store-connect.env.example
*.keystore
*.jks
*.p8
*.p12
*.pem
*.cer
*.key
*.mobileprovision
